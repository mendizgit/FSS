# Placeholders only. Copy to .env, fill in, then: chmod 600 .env  (never commit .env)

# --- Database ---
POSTGRES_USER=tss
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=tss
# Dev (native backend -> dockerised db). In production compose the host is `db`.
DATABASE_URL=postgresql+asyncpg://tss:CHANGE_ME@127.0.0.1:5432/tss

# --- Caddy / LAN access ---
BASIC_AUTH_USER=CHANGE_ME
# bcrypt hash from: docker run --rm caddy:2 caddy hash-password --plaintext '<password>'
BASIC_AUTH_HASH=CHANGE_ME
UBUNTU_LAN_IP=192.168.x.x
LAN_CLIENT_IP=192.168.x.x

# --- App ---
DISPLAY_TZ=Asia/Kolkata
RETENTION_DAYS=5
LOG_LEVEL=INFO

# --- Optional / later phases ---
CRYPTOPANIC_API_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
