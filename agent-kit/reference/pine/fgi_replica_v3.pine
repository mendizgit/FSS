//@version=6
// FGI Replica V3
// S / M / R engine: port of "Range Filter [DW]" by DonovanWall (Mozilla Public License 2.0),
//   run with "Average Filter Changes" on - this is the exact configuration FGI COM uses.
// RSI divergence engine: port (RSI only) of "Divergence for Many Indicators v4"
//   by LonesomeTheBlue (Mozilla Public License 2.0, https://mozilla.org/MPL/2.0/)
// Context layer (EMAs, levels, consolidated trend + TD, 4H / 1H SuperTrend, dashboard) is taken from
//   FGI Pro Strategy v3.0.
//
// Entry signal (dashboard only, 5m and 15m, evaluated on the last CLOSED bar of each):
//   mandatory: local SuperTrend agrees, SAR agrees, StochRSI K vs D agrees
//              (5m signal: 3m StochRSI; 15m signal: last closed 5m StochRSI)
//   score of at least N out of 6: local SuperTrend, COM M trend on 1H, price vs EMA 1,
//              TD within the last bars, RSI divergence, sweep & engulf
//
// Colours, line widths and on/off switches for everything that is a plot (R, S, M, EMAs, VWAP,
// consolidated trend, bullT / bearT / BUY / SELL / TD, s / r letters, fills) live in the STYLE tab.
// Inputs hold values only. Only objects Pine cannot style keep colour inputs (right-hand S/M/R
// labels, daily / weekly level lines, divergence lines, latest-only bullT / bearT labels, the dashboard).
indicator("FGI Replica V3", overlay = true, max_lines_count = 200, max_labels_count = 200, max_bars_back = 500)

// ══ Inputs: S / M / R range filter ════════════════════════════════════════
grpRf = "S / M / R  -  Range Filter"
rfType   = input.string("Type 1", "Filter type", options = ["Type 1", "Type 2"], group = grpRf)
rfMov    = input.string("Close", "Movement source", options = ["Close", "Wicks"], group = grpRf)
rfQty    = input.float(2.618, "Range size (x average change)", minval = 0.0000001, step = 0.001, group = grpRf)
rfPer    = input.int(14, "Range period", minval = 1, group = grpRf)
rfSmooth = input.bool(true, "Smooth range", group = grpRf)
rfSmPer  = input.int(27, "Smoothing period", minval = 1, group = grpRf)
rfAvg    = input.bool(true, "Average filter changes (COM setting)", group = grpRf)
rfAvgN   = input.int(2, "Number of changes to average", minval = 1, group = grpRf)
showExt  = input.bool(true, "Extend S / M / R to the right with price labels", group = grpRf)
extBars  = input.int(21, "Extension length in bars (COM uses 21 on every timeframe)", minval = 1, maxval = 400, group = grpRf)

// ══ Inputs: BUY / SELL ════════════════════════════════════════════════════
grpBs = "BUY / SELL"
rsiLen   = input.int(14, "RSI length", minval = 2, group = grpBs)
useGate  = input.bool(true, "Require RSI extreme before the flip (COM rule)", group = grpBs)
gateBars = input.int(20, "RSI lookback bars", minval = 1, group = grpBs)
buyOS    = input.float(30.0, "BUY: RSI was at or below", group = grpBs)
sellOB   = input.float(70.0, "SELL: RSI was at or above", group = grpBs)

// ══ Inputs: bullT / bearT ═════════════════════════════════════════════════
// Off: every flip is plotted (colours in the Style tab). On: like COM, only the newest bullT and
// the newest bearT stay on the chart (drawn as labels, so their colours are inputs here).
grpTr = "bullT / bearT"
latestOnly = input.bool(false, "Show only the latest bullT and bearT (like COM)", group = grpTr)
colBullL   = input.color(#67BF15, "Latest-only bullT label", group = grpTr)
colBearL   = input.color(#A91893, "Latest-only bearT label", group = grpTr)
colTxtL    = input.color(color.white, "Latest-only label text", group = grpTr)

// ══ Inputs: RSI cloud ═════════════════════════════════════════════════════
// FGI COM's "RSI BG": the band between the price at which RSI would reach the overbought level
// and the price at which it would reach the oversold level (colour / visibility: Style tab).
grpCl = "RSI Cloud"
cloudLen = input.int(14, "RSI length", minval = 2, group = grpCl)
cloudOB  = input.float(70.0, "Overbought level", minval = 51.0, maxval = 99.0, group = grpCl)
cloudOS  = input.float(30.0, "Oversold level", minval = 1.0, maxval = 49.0, group = grpCl)

// ══ Inputs: extreme zones ═════════════════════════════════════════════════
// Approximation of FGI COM's orange (top) and green (bottom) extreme zones, rebuilt from COM's
// plotted data: one centre line (long average), an outer half-width of ~3 x a 200-bar standard
// deviation, a sub zone whose inner edge sits at 0.764 of that half-width, and a larger main zone.
// Like COM, the zones step only when the S / M / R filter moves. Colours: Style tab.
grpZn = "Extreme Zones"
showZones   = input.bool(true, "Show extreme zones", group = grpZn)
zoneMaLen   = input.int(190, "Centre line: average length", minval = 2, group = grpZn)
zoneSdLen   = input.int(200, "Width: standard deviation length", minval = 2, group = grpZn)
zoneMult    = input.float(3.0, "Width: outer edge = this x deviation", minval = 0.1, step = 0.1, group = grpZn)
zoneBias    = input.float(0.11, "Centre offset (x outer half-width)", step = 0.01, group = grpZn)
zoneInner   = input.float(0.764, "Sub zone: inner edge (x outer half-width)", minval = 0.0, maxval = 1.0, step = 0.001, group = grpZn)
zoneMainIn  = input.float(0.667, "Main zone: inner edge (x outer half-width)", minval = 0.0, step = 0.01, group = grpZn)
zoneMainOut = input.float(1.4, "Main zone: outer edge (x outer half-width)", minval = 0.0, step = 0.01, group = grpZn)

// ══ Inputs: EMAs ══════════════════════════════════════════════════════════
// EMA 1 and EMA 2 drive TD and the consolidated trend; EMA 1 is also the entry-zone factor of the
// score (price above / below EMA 1). EMA 3 is only a plotted line. Colours / widths / on-off: Style tab.
grpEma = "EMAs"
ema1Len = input.int(6, "EMA 1 length (fast)", minval = 1, group = grpEma)
ema2Len = input.int(24, "EMA 2 length (slow)", minval = 1, group = grpEma)
ema3Len = input.int(32, "EMA 3 length (line only)", minval = 1, group = grpEma)
emaSrc  = input.source(close, "EMA source", group = grpEma)

// ══ Inputs: consolidated trend + TD ═══════════════════════════════════════
// From FGI Pro Strategy v3.0: EMA(close, average of EMA 1 and EMA 2 lengths), coloured by the
// confirmed EMA 1 / EMA 2 order. Drawn as three plots (bullish / bearish / unconfirmed), so the
// colours and width are in the Style tab.
// "TD" prints where the EMA cross or the local SuperTrend flips while both agree.
grpCt = "Consolidated Trend + TD"
showCT       = input.bool(true, "Show consolidated trend line", group = grpCt)
showTD       = input.bool(true, "Show TD labels (colours in Style)", group = grpCt)

// ══ Inputs: daily / weekly levels ═════════════════════════════════════════
// Same drawing method as FGI Pro Strategy v3.0: one line per level from the last bar forward,
// with a label (DH, DL, PDH, PDL, WH, WL) at its end. Drawn objects cannot be coloured in the Style
// tab, so their colours / widths live here (label text takes the line colour).
grpLv = "Daily / Weekly Levels"
showDailyHL    = input.bool(true, "Show daily high / low (DH, DL)", group = grpLv)
dailyHLCol     = input.color(#04F704, "Daily high / low colour", group = grpLv)
dailyHLWidth   = input.int(2, "Daily line width", minval = 1, maxval = 4, group = grpLv)
showPrevDayHL  = input.bool(true, "Show previous-day high / low (PDH, PDL)", group = grpLv)
prevDayHLCol   = input.color(#FFA726, "Previous-day high / low colour", group = grpLv)
prevDayHLWidth = input.int(2, "Previous-day line width", minval = 1, maxval = 4, group = grpLv)
showWeekHL     = input.bool(true, "Show week high / low (WH, WL)", group = grpLv)
weekHLCol      = input.color(#29B6F6, "Week high / low colour", group = grpLv)
weekHLWidth    = input.int(2, "Week line width", minval = 1, maxval = 4, group = grpLv)
lvlExt         = input.int(20, "Lines extend this many bars to the right", minval = 1, maxval = 200, group = grpLv)

// ══ Inputs: SuperTrend (local + information rows) ═════════════════════════
// The 4H SuperTrend is information only (dashboard row).
// The same multiplier / ATR length is used by the local SuperTrend and the 1H information row.
grpHt = "SuperTrend (4H info, local)"
htfTF    = input.timeframe("240", "Higher-timeframe trend: timeframe", group = grpHt)
stMult   = input.float(2.168, "SuperTrend multiplier", minval = 0.1, step = 0.1, group = grpHt)
stLen    = input.int(8, "SuperTrend ATR length", minval = 1, group = grpHt)

// ══ Inputs: score factors ═════════════════════════════════════════════════
grpSc = "Score factors"
gRsiLen  = input.int(14, "Divergence factor: RSI length", minval = 2, group = grpSc)
gDivLen  = input.int(3, "Divergence factor: pivot length", minval = 1, group = grpSc)

// ══ Inputs: dashboard ═════════════════════════════════════════════════════
grpTb = "Dashboard"
showTable  = input.bool(true, "Show dashboard table", group = grpTb)
tablePosIn = input.string("Top right", "Table position", options = ["Top right", "Top left", "Middle right", "Middle left", "Bottom right", "Bottom left"], group = grpTb)
tableSizeIn = input.string("Small", "Table text size", options = ["Tiny", "Small", "Normal"], group = grpTb)

// ══ Inputs: s / r letters ═════════════════════════════════════════════════
// Setup 1 (rejection): previous bar closed beyond the band, wick through the band, close back inside,
// previous-bar RSI at an extreme.
grpLt = "s / r Letters"
l1In     = input.float(0.025, "Setup 1: close back inside the band by (x half-width)", step = 0.005, minval = 0.0, group = grpLt)
l1RsiR   = input.float(60.8, "Setup 1 r: previous-bar RSI above", group = grpLt)
l1RsiS   = input.float(36.0, "Setup 1 s: previous-bar RSI below", group = grpLt)

// ══ Inputs: right-hand S / M / R labels (drawn objects - colours cannot live in Style) ═
grpExt = "Right-hand level labels (colours)"
colXR    = input.color(#FF4242, "R", group = grpExt)
colXMUp  = input.color(#2962FF, "M - uptrend", group = grpExt)
colXMDn  = input.color(#FF4242, "M - downtrend", group = grpExt)
colXS    = input.color(#56C123, "S", group = grpExt)

// ══ Inputs: RSI divergence ════════════════════════════════════════════════
grpDiv = "RSI Divergence"
divOn        = input.bool(true, "Show RSI divergence", group = grpDiv)
divRsiLen    = input.int(14, "RSI length", minval = 2, group = grpDiv)
divPrd       = input.int(5, "Pivot period", minval = 1, maxval = 50, group = grpDiv)
divSource    = input.string("Close", "Source for pivot points", options = ["Close", "High/Low"], group = grpDiv)
divType      = input.string("Regular", "Divergence type", options = ["Regular", "Hidden", "Regular/Hidden"], group = grpDiv)
divNames     = input.string("Full", "Show indicator name", options = ["Full", "First Letter", "Don't Show"], group = grpDiv)
divMaxPP     = input.int(10, "Maximum pivot points to check", minval = 1, maxval = 20, group = grpDiv)
divMaxBars   = input.int(100, "Maximum bars to check", minval = 30, maxval = 200, group = grpDiv)
divShowLast  = input.bool(true, "Show only last divergence", group = grpDiv)
divNoConfirm = input.bool(true, "Don't wait for confirmation", group = grpDiv)
divLines     = input.bool(true, "Show divergence lines", group = grpDiv)
divPivots    = input.bool(false, "Show pivot points", group = grpDiv)
regStyleIn   = input.string("Solid", "Regular divergence line style", options = ["Solid", "Dashed", "Dotted"], group = grpDiv)
hidStyleIn   = input.string("Dashed", "Hidden divergence line style", options = ["Solid", "Dashed", "Dotted"], group = grpDiv)
regWidth     = input.int(2, "Regular divergence line width", minval = 1, maxval = 5, group = grpDiv)
hidWidth     = input.int(1, "Hidden divergence line width", minval = 1, maxval = 5, group = grpDiv)
colPosReg    = input.color(color.yellow, "Positive regular divergence", group = grpDiv)
colNegReg    = input.color(color.navy, "Negative regular divergence", group = grpDiv)
colPosHid    = input.color(color.lime, "Positive hidden divergence", group = grpDiv)
colNegHid    = input.color(color.red, "Negative hidden divergence", group = grpDiv)
colTxtPos    = input.color(color.black, "Positive divergence text", group = grpDiv)
colTxtNeg    = input.color(color.white, "Negative divergence text", group = grpDiv)

// ══ Inputs: entry signal (dashboard) ══════════════════════════════════════
grpSg = "Entry Signal (dashboard)"
gateTF     = input.timeframe("60", "1H SuperTrend timeframe (dashboard information only)", group = grpSg)
sgTdBars   = input.int(7, "Score: TD of the same side within the last N bars (signal bar counts)", minval = 1, maxval = 20, group = grpSg)
sgMinScore = input.int(3, "Minimum score (of 6)", minval = 1, maxval = 6, group = grpSg)
sgUseSar   = input.bool(true, "Require Parabolic SAR agreement", group = grpSg)
sarStart   = input.float(0.02, "SAR start", minval = 0.001, step = 0.01, group = grpSg)
sarInc     = input.float(0.02, "SAR increment", minval = 0.001, step = 0.01, group = grpSg)
sarMax     = input.float(0.2, "SAR maximum", minval = 0.01, step = 0.01, group = grpSg)
comTF      = input.timeframe("60", "Score: COM M trend timeframe", group = grpSg)
srRsiLen   = input.int(14, "StochRSI: RSI length", minval = 1, group = grpSg)
srStochLen = input.int(14, "StochRSI: stochastic length", minval = 1, group = grpSg)
srSmK      = input.int(3, "StochRSI: K smoothing", minval = 1, group = grpSg)
srSmD      = input.int(3, "StochRSI: D smoothing", minval = 1, group = grpSg)
st3Live    = input.bool(true, "5m signal: use the forming 3m candle for StochRSI (off = last closed 3m candle)", group = grpSg)

// ══ S / M / R: Range Filter [DW] ══════════════════════════════════════════
// Range = rfQty x EMA(|bar-to-bar change|, rfPer), optionally smoothed by a second EMA.
// The filter holds flat until price moves a full range away, then trails price at that
// distance. Bands = filter +/- range. "Average filter changes" runs filter and bands through
// an EMA that only takes a new sample when the filter moves (this is what FGI COM plots as
// "Averaged Middle" / "Resistance Level" / "Support Level").
condEma(float x, bool cond, int n) =>
    var float e = na
    if cond and not na(x)
        e := na(e) ? x : e + (x - e) * 2.0 / (n + 1)
    e

float rfH   = rfMov == "Wicks" ? high : close
float rfL   = rfMov == "Wicks" ? low : close
float rfX   = (rfH + rfL) / 2.0
float rfAC  = ta.ema(math.abs(rfX - rfX[1]), rfPer)
float rfRng = rfQty * rfAC
float rfR   = rfSmooth ? ta.ema(rfRng, rfSmPer) : rfRng

var float rfFilt = na
float rfPrev = na(rfFilt) ? rfX : rfFilt
float rfNext = rfPrev
if not na(rfR)
    if rfType == "Type 1"
        if rfH - rfR > rfPrev
            rfNext := rfH - rfR
        if rfL + rfR < rfPrev
            rfNext := rfL + rfR
    else
        if rfH >= rfPrev + rfR
            rfNext := rfPrev + math.floor(math.abs(rfH - rfPrev) / rfR) * rfR
        if rfL <= rfPrev - rfR
            rfNext := rfPrev - math.floor(math.abs(rfL - rfPrev) / rfR) * rfR
rfFilt := rfNext

bool rfMoved = rfFilt != rfFilt[1]
float lineM = rfAvg ? condEma(rfFilt, rfMoved, rfAvgN) : rfFilt
float lineR = rfAvg ? condEma(rfFilt + rfR, rfMoved, rfAvgN) : rfFilt + rfR
float lineS = rfAvg ? condEma(rfFilt - rfR, rfMoved, rfAvgN) : rfFilt - rfR

// Trend = direction of the last M move
var int trend = 0
trend := lineM > lineM[1] ? 1 : lineM < lineM[1] ? -1 : trend
isUp = trend == 1

// Same engine as above, packaged so it can run on another timeframe (COM M trend on 1H).
// Returns +1 / -1 / 0 (direction of the last M move).
rfTrendFn() =>
    float h = rfMov == "Wicks" ? high : close
    float l = rfMov == "Wicks" ? low : close
    float x = (h + l) / 2.0
    float ac = ta.ema(math.abs(x - x[1]), rfPer)
    float rg = rfQty * ac
    float rr = rfSmooth ? ta.ema(rg, rfSmPer) : rg
    var float filt = na
    float prev = na(filt) ? x : filt
    float nxt = prev
    if not na(rr)
        if rfType == "Type 1"
            if h - rr > prev
                nxt := h - rr
            if l + rr < prev
                nxt := l + rr
        else
            if h >= prev + rr
                nxt := prev + math.floor(math.abs(h - prev) / rr) * rr
            if l <= prev - rr
                nxt := prev - math.floor(math.abs(l - prev) / rr) * rr
    filt := nxt
    bool moved = filt != filt[1]
    float m = rfAvg ? condEma(filt, moved, rfAvgN) : filt
    var int tr = 0
    tr := m > m[1] ? 1 : m < m[1] ? -1 : tr
    tr

// ── Plots (all colours / widths / visibility are in the Style tab) ────────
pR  = plot(lineR, "R", color = #FF4242, linewidth = 2, style = plot.style_linebr)
pS  = plot(lineS, "S", color = #56C123, linewidth = 2, style = plot.style_linebr)
plot(lineM, "M - downtrend", color = #FF4242, linewidth = 2, style = plot.style_linebr)
plot(isUp ? lineM : na, "M - uptrend", color = #2962FF, linewidth = 2, style = plot.style_linebr)
pRu = plot(isUp ? lineR : na, "R (uptrend fill anchor)", display = display.none, editable = false)
pSu = plot(isUp ? lineS : na, "S (uptrend fill anchor)", display = display.none, editable = false)
pRd = plot(isUp ? na : lineR, "R (downtrend fill anchor)", display = display.none, editable = false)
pSd = plot(isUp ? na : lineS, "S (downtrend fill anchor)", display = display.none, editable = false)
fill(pRu, pSu, #2962FF1F, title = "Band fill - uptrend")
fill(pRd, pSd, #FF42421F, title = "Band fill - downtrend")

// ── RSI cloud (FGI COM "RSI BG") ──────────────────────────────────────────
// Price that would take Wilder RSI to a target on this bar's averages (the level for the next
// bar). If the target RSI is above the current RSI, price has to rise; otherwise it has to fall.
// The two level plots only feed the fill, so they are hidden from the Style tab.
float rcChg  = ta.change(close)
float rcGain = ta.rma(math.max(rcChg, 0.0), cloudLen)
float rcLoss = ta.rma(-math.min(rcChg, 0.0), cloudLen)

priceAtRsi(float target) =>
    float rs  = target / (100.0 - target)
    float cur = rcLoss == 0 ? 1.0e10 : rcGain / rcLoss
    rs >= cur ? close + ((cloudLen - 1) * rcLoss * rs - (cloudLen - 1) * rcGain) : close - ((cloudLen - 1) * rcGain / rs - (cloudLen - 1) * rcLoss)

float rcOb  = priceAtRsi(cloudOB)
float rcOs  = priceAtRsi(cloudOS)
pOb = plot(rcOb, "RSI overbought level", display = display.none, editable = false)
pOs = plot(rcOs, "RSI oversold level", display = display.none, editable = false)
fill(pOb, pOs, #00897B0D, title = "RSI cloud")

// ── Extreme zones (approximation of FGI COM's orange / green clouds) ──────
float zMa = ta.sma(hl2, zoneMaLen)
float zSd = ta.stdev(hlc3, zoneSdLen)
var float zC = na
var float zB = na
if rfMoved and not na(zMa[1]) and not na(zSd[1])
    zB := zoneMult * zSd[1]
    zC := zMa[1] + zoneBias * zB

float zCp = showZones ? zC : na
float zBp = showZones ? zB : na
pZs1 = plot(zCp + zoneInner * zBp, "Sub zone top - inner", display = display.none, editable = false)
pZs2 = plot(zCp + zBp, "Sub zone top - outer", display = display.none, editable = false)
pZs3 = plot(zCp - zoneInner * zBp, "Sub zone bottom - inner", display = display.none, editable = false)
pZs4 = plot(zCp - zBp, "Sub zone bottom - outer", display = display.none, editable = false)
pZm1 = plot(zCp + zoneMainIn * zBp, "Main zone top - inner", display = display.none, editable = false)
pZm2 = plot(zCp + zoneMainOut * zBp, "Main zone top - outer", display = display.none, editable = false)
pZm3 = plot(zCp - zoneMainIn * zBp, "Main zone bottom - inner", display = display.none, editable = false)
pZm4 = plot(zCp - zoneMainOut * zBp, "Main zone bottom - outer", display = display.none, editable = false)
fill(pZm1, pZm2, #FF980033, title = "Extreme zone - main top")
fill(pZm3, pZm4, #4CAF5033, title = "Extreme zone - main bottom")
fill(pZs1, pZs2, #FF98001A, title = "Extreme zone - sub top")
fill(pZs3, pZs4, #4CAF501A, title = "Extreme zone - sub bottom")

// ══ Context layer (from FGI Pro Strategy v3.0) ════════════════════════════
// ── EMAs ──────────────────────────────────────────────────────────────────
float ema1 = ta.ema(emaSrc, ema1Len)
float ema2 = ta.ema(emaSrc, ema2Len)
float ema3 = ta.ema(emaSrc, ema3Len)
plot(ema1, "EMA 1", color = color.rgb(230, 226, 20), linewidth = 1)
plot(ema2, "EMA 2", color = #AB47BC, linewidth = 1)
plot(ema3, "EMA 3", color = #2650da, linewidth = 1)

// ── Levels (FGI Pro Strategy v3.0 method): live daily / week high-low and yesterday's high-low ─
[dailyHighVal, dailyLowVal] = request.security(syminfo.tickerid, "D", [high, low], lookahead = barmerge.lookahead_on)
[prevDayHighVal, prevDayLowVal] = request.security(syminfo.tickerid, "D", [high[1], low[1]], lookahead = barmerge.lookahead_on)
[weekHighVal, weekLowVal] = request.security(syminfo.tickerid, "W", [high, low], lookahead = barmerge.lookahead_on)
float vwapV = ta.vwap(hlc3)

var line dhLine = line.new(na, na, na, na, xloc = xloc.bar_time, style = line.style_solid)
var label dhLbl = label.new(na, na, xloc = xloc.bar_time, text = "DH", color = color.new(color.white, 100), style = label.style_label_left, size = size.small)
var line dlLine = line.new(na, na, na, na, xloc = xloc.bar_time, style = line.style_solid)
var label dlLbl = label.new(na, na, xloc = xloc.bar_time, text = "DL", color = color.new(color.white, 100), style = label.style_label_left, size = size.small)
var line pdhLine = line.new(na, na, na, na, xloc = xloc.bar_time, style = line.style_solid)
var label pdhLbl = label.new(na, na, xloc = xloc.bar_time, text = "PDH", color = color.new(color.white, 100), style = label.style_label_left, size = size.small)
var line pdlLine = line.new(na, na, na, na, xloc = xloc.bar_time, style = line.style_solid)
var label pdlLbl = label.new(na, na, xloc = xloc.bar_time, text = "PDL", color = color.new(color.white, 100), style = label.style_label_left, size = size.small)
var line whLine = line.new(na, na, na, na, xloc = xloc.bar_time, style = line.style_solid)
var label whLbl = label.new(na, na, xloc = xloc.bar_time, text = "WH", color = color.new(color.white, 100), style = label.style_label_left, size = size.small)
var line wlLine = line.new(na, na, na, na, xloc = xloc.bar_time, style = line.style_solid)
var label wlLbl = label.new(na, na, xloc = xloc.bar_time, text = "WL", color = color.new(color.white, 100), style = label.style_label_left, size = size.small)

drawLevel(line ln, label lb, float v, color c, int w, bool on) =>
    int tEnd = time + (time - time[1]) * lvlExt
    if on and not na(v)
        line.set_xy1(ln, time, v)
        line.set_xy2(ln, tEnd, v)
        line.set_color(ln, c)
        line.set_width(ln, w)
        label.set_xy(lb, tEnd, v)
        label.set_textcolor(lb, c)
    else
        line.set_xy1(ln, na, na)
        line.set_xy2(ln, na, na)
        label.set_xy(lb, na, na)

if barstate.islast
    drawLevel(dhLine, dhLbl, dailyHighVal, dailyHLCol, dailyHLWidth, showDailyHL)
    drawLevel(dlLine, dlLbl, dailyLowVal, dailyHLCol, dailyHLWidth, showDailyHL)
    drawLevel(pdhLine, pdhLbl, prevDayHighVal, prevDayHLCol, prevDayHLWidth, showPrevDayHL)
    drawLevel(pdlLine, pdlLbl, prevDayLowVal, prevDayHLCol, prevDayHLWidth, showPrevDayHL)
    drawLevel(whLine, whLbl, weekHighVal, weekHLCol, weekHLWidth, showWeekHL)
    drawLevel(wlLine, wlLbl, weekLowVal, weekHLCol, weekHLWidth, showWeekHL)

plot(vwapV, "VWAP", color = color.rgb(230, 140, 6), linewidth = 1)

// ── SuperTrends: 4H and 1H are information only, local = chart timeframe ──
[stHTF, dirHTF] = request.security(syminfo.tickerid, htfTF, ta.supertrend(stMult, stLen), gaps = barmerge.gaps_off)
[st1H, dir1H] = request.security(syminfo.tickerid, gateTF, ta.supertrend(stMult, stLen), gaps = barmerge.gaps_off)
[_, dirLoc] = ta.supertrend(stMult, stLen)
htfBull = dirHTF < 0
htfBear = dirHTF > 0
h1Bull = dir1H < 0
h1Bear = dir1H > 0
locBull = dirLoc < 0
locBear = dirLoc > 0

// COM M trend on the 1H (information row; the same value feeds the score inside the entry pack)
int comTrendHtf = request.security(syminfo.tickerid, comTF, rfTrendFn(), gaps = barmerge.gaps_off)
comBull = comTrendHtf == 1
comBear = comTrendHtf == -1

// ── Consolidated trend + TD (FGI Pro Strategy v3.0, same logic) ───────────
// ctUp = EMA 1 above EMA 2; the trend is confirmed after two bars in a row (Pro: count > 1).
// The line is a single EMA of close (length = average of the two EMA lengths) whose colour
// follows the confirmed trend.
bool ctUp = ema1 > ema2
var int ctBuyCount = 0
var int ctSellCount = 0
if ctUp
    ctBuyCount += 1
    ctSellCount := 0
else
    ctSellCount += 1
    ctBuyCount := 0
bool ctConfirmedBull = ctBuyCount > 1
bool ctConfirmedBear = ctSellCount > 1
float consolidatedTrendLine = ta.ema(close, math.round((ema1Len + ema2Len) / 2))
// Three plots (one per state) so the colours and width live in the Style tab. Each plot also
// includes the first bar of the next state, so the line stays joined at every colour change.
bool ctNeutral = not ctConfirmedBull and not ctConfirmedBear
float ctLineOn = showCT ? consolidatedTrendLine : na
plot((ctConfirmedBull or ctConfirmedBull[1]) ? ctLineOn : na, "Consolidated trend - bullish", color = #00E5FF, linewidth = 2, style = plot.style_linebr)
plot((ctConfirmedBear or ctConfirmedBear[1]) ? ctLineOn : na, "Consolidated trend - bearish", color = #E040FB, linewidth = 2, style = plot.style_linebr)
plot((ctNeutral or ctNeutral[1]) ? ctLineOn : na, "Consolidated trend - unconfirmed", color = #FF530D, linewidth = 2, style = plot.style_linebr)

// TD: EMA cross or local SuperTrend flips, and both now point the same way
bool ctBullFlip = ctUp and not ctUp[1]
bool ctBearFlip = not ctUp and ctUp[1]
bool stBullFlip = locBull and not locBull[1]
bool stBearFlip = locBear and not locBear[1]
bool tdBull = (ctBullFlip or stBullFlip) and ctUp and locBull
bool tdBear = (ctBearFlip or stBearFlip) and not ctUp and locBear
plotshape(showTD and tdBull, "TD bull", shape.labelup, location.belowbar, color.green, text = "TD", textcolor = color.white, size = size.small)
plotshape(showTD and tdBear, "TD bear", shape.labeldown, location.abovebar, color.red, text = "TD", textcolor = color.white, size = size.small)

// ── Levels extended to the right (COM: last bar -> +21 bars, label at the end) ─
var line lnR = na
var line lnM = na
var line lnS = na
var label lbR = na
var label lbM = na
var label lbS = na

cR = lineR
cM = lineM
cS = lineS
colXM = isUp ? colXMUp : colXMDn

if showExt and barstate.islast
    line.delete(lnR)
    line.delete(lnM)
    line.delete(lnS)
    label.delete(lbR)
    label.delete(lbM)
    label.delete(lbS)
    lnR := line.new(bar_index, cR, bar_index + extBars, cR, color = colXR, width = 2)
    lnM := line.new(bar_index, cM, bar_index + extBars, cM, color = colXM, width = 2)
    lnS := line.new(bar_index, cS, bar_index + extBars, cS, color = colXS, width = 2)
    lbR := label.new(bar_index + extBars, cR, " (R)  " + str.tostring(cR, format.mintick), style = label.style_label_left, color = color.new(colXR, 80), textcolor = colXR, size = size.small)
    lbM := label.new(bar_index + extBars, cM, " (M)  " + str.tostring(cM, format.mintick), style = label.style_label_left, color = color.new(colXM, 80), textcolor = colXM, size = size.small)
    lbS := label.new(bar_index + extBars, cS, " (S)  " + str.tostring(cS, format.mintick), style = label.style_label_left, color = color.new(colXS, 80), textcolor = colXS, size = size.small)

// ══ s / r letters ═════════════════════════════════════════════════════════
// Fitted against FGI COM's own letters across 5m / 15m / 30m / 1h / 4h (see notes in the docs).
rsiD    = ta.rsi(close, rsiLen)
hwNow   = lineR - lineM
prevBeyondR = close[1] > lineR[1]
prevBeyondS = close[1] < lineS[1]

r1 = prevBeyondR and high > lineR and close < lineR - l1In * hwNow and rsiD[1] > l1RsiR
s1 = prevBeyondS and low < lineS and close > lineS + l1In * hwNow and rsiD[1] < l1RsiS

plotchar(r1, "r (setup 1)", "r", location = location.abovebar, color = #FF5252, size = size.tiny)
plotchar(s1, "s (setup 1)", "s", location = location.belowbar, color = #4CAF50, size = size.tiny)

// ══ Trend flips and BUY / SELL ════════════════════════════════════════════
// bullT / bearT: M turns up / down (price broke out of the held R / S band).
// BUY / SELL (COM rule): the flip, but only if RSI was oversold (BUY) or overbought (SELL)
// at some point in the last gateBars bars, i.e. the flip ends a stretched move.
rsiLow  = ta.lowest(rsiD, gateBars + 1)
rsiHigh = ta.highest(rsiD, gateBars + 1)
bullT   = trend == 1 and trend[1] == -1
bearT   = trend == -1 and trend[1] == 1
buySig  = bullT and (not useGate or rsiLow <= buyOS)
sellSig = bearT and (not useGate or rsiHigh >= sellOB)

plotshape(bullT and not latestOnly, "bullT", shape.labelup, location.belowbar, #67BF15, text = "bullT", textcolor = color.white, size = size.small)
plotshape(bearT and not latestOnly, "bearT", shape.labeldown, location.abovebar, #A91893, text = "bearT", textcolor = color.white, size = size.small)

// Latest-only mode: keep a single bullT and a single bearT label (the previous one is deleted)
var label lbBullT = na
var label lbBearT = na
if latestOnly and bullT
    label.delete(lbBullT)
    lbBullT := label.new(bar_index, na, "bullT", yloc = yloc.belowbar, style = label.style_label_up, color = colBullL, textcolor = colTxtL, size = size.small)
if latestOnly and bearT
    label.delete(lbBearT)
    lbBearT := label.new(bar_index, na, "bearT", yloc = yloc.abovebar, style = label.style_label_down, color = colBearL, textcolor = colTxtL, size = size.small)

plotshape(buySig, "BUY", shape.labelup, location.belowbar, #31BD4F, text = "BUY", textcolor = color.white, size = size.small)
plotshape(sellSig, "SELL", shape.labeldown, location.abovebar, #FF3E3E, text = "SELL", textcolor = color.white, size = size.small)

// ══ Entry signal pack: the base signal, evaluated in whatever timeframe it is requested in ═══
// Everything is read from the previous bar ([1]) of that timeframe, i.e. the last CLOSED bar.
// Mandatory here: local SuperTrend and SAR. Score (of 6): local SuperTrend, COM M trend on 1H,
// price vs EMA 1, TD within the last bars, RSI divergence, sweep & engulf. The StochRSI gate is
// added outside (it uses a different timeframe). Returns, per side: local ok, SAR ok,
// score, base signal.
entryPack() =>
    // Local SuperTrend and TD
    [_, dirX] = ta.supertrend(stMult, stLen)
    bool xBull = dirX < 0
    bool xBear = dirX > 0
    float e1 = ta.ema(emaSrc, ema1Len)
    float e2 = ta.ema(emaSrc, ema2Len)
    bool up = e1 > e2
    bool tdB = ((up and not up[1]) or (xBull and not xBull[1])) and up and xBull
    bool tdS = ((not up and up[1]) or (xBear and not xBear[1])) and not up and xBear
    bool tdBOk = nz(ta.barssince(tdB), 9999) < sgTdBars
    bool tdSOk = nz(ta.barssince(tdS), 9999) < sgTdBars
    // Sweep & engulf (sticky 5 bars)
    bool swB = low < low[1] and close > high[1] and close > open
    bool swS = high > high[1] and close < low[1] and close < open
    var bool recSwB = false
    var bool recSwS = false
    var int swBBar = 0
    var int swSBar = 0
    if swB
        recSwB := true
        swBBar := bar_index
    if swS
        recSwS := true
        swSBar := bar_index
    if bar_index - swBBar > 5
        recSwB := false
    if bar_index - swSBar > 5
        recSwS := false
    // Single-previous-pivot RSI divergence (sticky 20 bars)
    float rs = ta.rsi(close, gRsiLen)
    float pvH = ta.pivothigh(rs, gDivLen, gDivLen)
    float pvL = ta.pivotlow(rs, gDivLen, gDivLen)
    var float pRH = na
    var float pPH = na
    var float cRH = na
    var float cPH = na
    var float pRL = na
    var float pPL = na
    var float cRL = na
    var float cPL = na
    if not na(pvH)
        pRH := cRH
        pPH := cPH
        cRH := rs[gDivLen]
        cPH := high[gDivLen]
    if not na(pvL)
        pRL := cRL
        pPL := cPL
        cRL := rs[gDivLen]
        cPL := low[gDivLen]
    bool bDiv = not na(pRL) and not na(cRL) and cPL < pPL and cRL > pRL and cRL < 50
    bool sDiv = not na(pRH) and not na(cRH) and cPH > pPH and cRH < pRH and cRH > 50
    var bool recBD = false
    var bool recSD = false
    var int bdBar = 0
    var int sdBar = 0
    if bDiv
        recBD := true
        bdBar := bar_index
    if sDiv
        recSD := true
        sdBar := bar_index
    if bar_index - bdBar > 20
        recBD := false
    if bar_index - sdBar > 20
        recSD := false
    // SAR and COM M trend on the 1H (a request nested inside the requested timeframe)
    float sv = ta.sar(sarStart, sarInc, sarMax)
    bool sarB = not sgUseSar or close > sv
    bool sarS = not sgUseSar or close < sv
    int comT = request.security(syminfo.tickerid, comTF, rfTrendFn(), gaps = barmerge.gaps_off)
    // Score, base signal
    int lSc = (xBull ? 1 : 0) + (comT == 1 ? 1 : 0) + (close > e1 ? 1 : 0) + (tdBOk ? 1 : 0) + (recBD ? 1 : 0) + (recSwB ? 1 : 0)
    int sSc = (xBear ? 1 : 0) + (comT == -1 ? 1 : 0) + (close < e1 ? 1 : 0) + (tdSOk ? 1 : 0) + (recSD ? 1 : 0) + (recSwS ? 1 : 0)
    bool lBase = xBull and sarB and lSc >= sgMinScore
    bool sBase = xBear and sarS and sSc >= sgMinScore
    [xBull[1] ? 1 : 0, sarB[1] ? 1 : 0, lSc[1], lBase[1] ? 1 : 0, xBear[1] ? 1 : 0, sarS[1] ? 1 : 0, sSc[1], sBase[1] ? 1 : 0]

// StochRSI K versus D: +1 = K above D, -1 = K below D, 0 = equal. live = forming candle, else the
// last closed candle of the requested timeframe.
stochDirFn(bool live) =>
    float r = ta.rsi(close, srRsiLen)
    float k = ta.sma(ta.stoch(r, r, r, srStochLen), srSmK)
    float d = ta.sma(k, srSmD)
    float kk = live ? k : k[1]
    float dd = live ? d : d[1]
    kk > dd ? 1 : kk < dd ? -1 : 0

[a5LLoc, a5LSar, a5LSc, a5LBase, a5SLoc, a5SSar, a5SSc, a5SBase] = request.security(syminfo.tickerid, "5", entryPack(), gaps = barmerge.gaps_off)
[a15LLoc, a15LSar, a15LSc, a15LBase, a15SLoc, a15SSar, a15SSc, a15SBase] = request.security(syminfo.tickerid, "15", entryPack(), gaps = barmerge.gaps_off)
int stoch3Dir = request.security(syminfo.tickerid, "3", stochDirFn(st3Live), gaps = barmerge.gaps_off)
int stoch5Dir = request.security(syminfo.tickerid, "5", stochDirFn(false), gaps = barmerge.gaps_off)

// Final signals: base signal AND the StochRSI gate (5m signal: 3m StochRSI, 15m signal: 5m StochRSI)
bool l5Final  = a5LBase == 1 and stoch3Dir == 1
bool s5Final  = a5SBase == 1 and stoch3Dir == -1
bool l15Final = a15LBase == 1 and stoch5Dir == 1
bool s15Final = a15SBase == 1 and stoch5Dir == -1

// ══ Dashboard: 4H / 1H SuperTrend and COM M trend (info), then the 5m and 15m entry signals ═══
tblPos = tablePosIn == "Top right" ? position.top_right : tablePosIn == "Top left" ? position.top_left : tablePosIn == "Middle right" ? position.middle_right : tablePosIn == "Middle left" ? position.middle_left : tablePosIn == "Bottom right" ? position.bottom_right : position.bottom_left
tblSize = tableSizeIn == "Tiny" ? size.tiny : tableSizeIn == "Normal" ? size.normal : size.small
var table dash = table.new(tblPos, 2, 10, bgcolor = color.new(#131722, 12), border_width = 1, border_color = color.new(color.gray, 60), frame_width = 1, frame_color = color.new(color.gray, 40))

dashRow(int r, string k, string v, color vc) =>
    table.cell(dash, 0, r, k, text_color = color.new(color.white, 15), text_halign = text.align_left, text_size = tblSize)
    table.cell(dash, 1, r, v, text_color = vc, text_halign = text.align_left, text_size = tblSize)

gatesTxt(int loc, int sar, bool sto, int sc) =>
    "Loc" + (loc == 1 ? "✓" : "✗") + " SAR" + (sar == 1 ? "✓" : "✗") + " Stoch" + (sto ? "✓" : "✗") + " " + str.tostring(sc) + "/6" + (sc >= sgMinScore ? "✓" : "✗")

sigTxtOf(bool lFin, bool sFin, bool lBase, bool sBase) =>
    lFin ? "▲ BUY · active" : sFin ? "▼ SELL · active" : (lBase or sBase) ? "— none · StochRSI not confirming" : "— none"

color cGood = #26A69A
color cBad  = #EF5350
color cDim  = #9598A1

if barstate.islast
    if showTable
        string stTxt = (htfBull ? "▲ BULL" : htfBear ? "▼ BEAR" : "—") + " · stop " + str.tostring(stHTF, format.mintick) + " (" + str.tostring(math.abs(close - stHTF) / close * 100, "#.00") + "%)"
        string st1Txt = (h1Bull ? "▲ BULL" : h1Bear ? "▼ BEAR" : "—") + " · stop " + str.tostring(st1H, format.mintick) + " (" + str.tostring(math.abs(close - st1H) / close * 100, "#.00") + "%)"
        string sarTxt = sgUseSar ? "" : " SAR off"
        table.cell(dash, 0, 0, "FGI Replica V3", text_color = color.white, text_halign = text.align_left, text_size = tblSize, bgcolor = color.new(#1E3A8A, 20))
        table.cell(dash, 1, 0, syminfo.ticker + (st3Live ? " · closed bars, 3m Stoch live" : " · closed bars"), text_color = color.white, text_halign = text.align_left, text_size = tblSize, bgcolor = color.new(#1E3A8A, 20))
        dashRow(1, "4H SuperTrend", stTxt, htfBull ? cGood : htfBear ? cBad : cDim)
        dashRow(2, "1H SuperTrend", st1Txt, h1Bull ? cGood : h1Bear ? cBad : cDim)
        dashRow(3, "COM M trend (" + comTF + ")", comBull ? "▲ UP" : comBear ? "▼ DOWN" : "—", comBull ? cGood : comBear ? cBad : cDim)
        dashRow(4, "5m · Long" + sarTxt, gatesTxt(a5LLoc, a5LSar, stoch3Dir == 1, a5LSc), l5Final ? cGood : cDim)
        dashRow(5, "5m · Short" + sarTxt, gatesTxt(a5SLoc, a5SSar, stoch3Dir == -1, a5SSc), s5Final ? cBad : cDim)
        dashRow(6, "15m · Long" + sarTxt, gatesTxt(a15LLoc, a15LSar, stoch5Dir == 1, a15LSc), l15Final ? cGood : cDim)
        dashRow(7, "15m · Short" + sarTxt, gatesTxt(a15SLoc, a15SSar, stoch5Dir == -1, a15SSc), s15Final ? cBad : cDim)
        dashRow(8, "ENTRY 5m", sigTxtOf(l5Final, s5Final, a5LBase == 1, a5SBase == 1), l5Final ? cGood : s5Final ? cBad : cDim)
        dashRow(9, "ENTRY 15m", sigTxtOf(l15Final, s15Final, a15LBase == 1, a15SBase == 1), l15Final ? cGood : s15Final ? cBad : cDim)
    else
        table.clear(dash, 0, 0, 1, 9)

// ══════════════════════════════════════════════════════════════════════════
// RSI divergence (port of LonesomeTheBlue's "Divergence for Many Indicators v4")
// ══════════════════════════════════════════════════════════════════════════
var regLineStyle = regStyleIn == "Solid" ? line.style_solid : regStyleIn == "Dashed" ? line.style_dashed : line.style_dotted
var hidLineStyle = hidStyleIn == "Solid" ? line.style_solid : hidStyleIn == "Dashed" ? line.style_dashed : line.style_dotted

divRsi = ta.rsi(close, divRsiLen)

// Pivot highs / lows
float divPh = ta.pivothigh(divSource == "Close" ? close : high, divPrd, divPrd)
float divPl = ta.pivotlow(divSource == "Close" ? close : low, divPrd, divPrd)
plotshape(divPivots and not na(divPh), "Pivot high", shape.labeldown, location.abovebar, color.new(color.white, 100), text = "H", textcolor = color.red, offset = -divPrd)
plotshape(divPivots and not na(divPl), "Pivot low", shape.labelup, location.belowbar, color.new(color.white, 100), text = "L", textcolor = color.lime, offset = -divPrd)

// Positions and values of the last 20 pivot highs / lows
var array<int>   phPos  = array.new<int>(20, 0)
var array<int>   plPos  = array.new<int>(20, 0)
var array<float> phVals = array.new<float>(20, 0.0)
var array<float> plVals = array.new<float>(20, 0.0)

if not na(divPh)
    array.unshift(phPos, bar_index)
    array.unshift(phVals, divPh)
    if array.size(phPos) > 20
        array.pop(phPos)
        array.pop(phVals)

if not na(divPl)
    array.unshift(plPos, bar_index)
    array.unshift(plVals, divPl)
    if array.size(plPos) > 20
        array.pop(plPos)
        array.pop(plVals)

// Positive regular (cond 1) or positive hidden (cond 2) divergence.
// Returns the distance in bars to the earlier pivot, or 0 when there is none.
divPositive(float src, int cond) =>
    int divlen = 0
    float prsc = divSource == "Close" ? close : low
    if divNoConfirm or src > src[1] or close > close[1]
        int startpoint = divNoConfirm ? 0 : 1
        for x = 0 to divMaxPP - 1
            int pos = array.get(plPos, x)
            int len = bar_index - pos + divPrd
            if pos == 0 or len > divMaxBars
                break
            if len > 5 and ((cond == 1 and src[startpoint] > src[len] and prsc[startpoint] < nz(array.get(plVals, x))) or (cond == 2 and src[startpoint] < src[len] and prsc[startpoint] > nz(array.get(plVals, x))))
                float slope1 = (src[startpoint] - src[len]) / (len - startpoint)
                float virtual1 = src[startpoint] - slope1
                float slope2 = (close[startpoint] - close[len]) / (len - startpoint)
                float virtual2 = close[startpoint] - slope2
                bool arrived = true
                for y = 1 + startpoint to len - 1
                    if src[y] < virtual1 or nz(close[y]) < virtual2
                        arrived := false
                        break
                    virtual1 := virtual1 - slope1
                    virtual2 := virtual2 - slope2
                if arrived
                    divlen := len
                    break
    divlen

// Negative regular (cond 1) or negative hidden (cond 2) divergence.
divNegative(float src, int cond) =>
    int divlen = 0
    float prsc = divSource == "Close" ? close : high
    if divNoConfirm or src < src[1] or close < close[1]
        int startpoint = divNoConfirm ? 0 : 1
        for x = 0 to divMaxPP - 1
            int pos = array.get(phPos, x)
            int len = bar_index - pos + divPrd
            if pos == 0 or len > divMaxBars
                break
            if len > 5 and ((cond == 1 and src[startpoint] < src[len] and prsc[startpoint] > nz(array.get(phVals, x))) or (cond == 2 and src[startpoint] > src[len] and prsc[startpoint] < nz(array.get(phVals, x))))
                float slope1 = (src[startpoint] - src[len]) / (len - startpoint)
                float virtual1 = src[startpoint] - slope1
                float slope2 = (close[startpoint] - nz(close[len])) / (len - startpoint)
                float virtual2 = close[startpoint] - slope2
                bool arrived = true
                for y = 1 + startpoint to len - 1
                    if src[y] > virtual1 or nz(close[y]) > virtual2
                        arrived := false
                        break
                    virtual1 := virtual1 - slope1
                    virtual2 := virtual2 - slope2
                if arrived
                    divlen := len
                    break
    divlen

// Only the requested divergence types are evaluated (the loops are the expensive part)
regOn = divType == "Regular" or divType == "Regular/Hidden"
hidOn = divType == "Hidden" or divType == "Regular/Hidden"
int dPosReg = regOn ? divPositive(divRsi, 1) : 0
int dNegReg = regOn ? divNegative(divRsi, 1) : 0
int dPosHid = hidOn ? divPositive(divRsi, 2) : 0
int dNegHid = hidOn ? divNegative(divRsi, 2) : 0

// Helpers to remove old lines / labels
deleteAllLines(array<line> arr) =>
    if array.size(arr) > 0
        for j = 0 to array.size(arr) - 1
            line.delete(array.get(arr, j))
        array.clear(arr)

deleteAllLabels(array<label> arr) =>
    if array.size(arr) > 0
        for j = 0 to array.size(arr) - 1
            label.delete(array.get(arr, j))
        array.clear(arr)

deleteLastLines(array<line> lines, array<label> labels, int n) =>
    if n > 0 and array.size(lines) >= n
        int asz = array.size(lines)
        for j = 1 to n
            line.delete(array.get(lines, asz - j))
            array.pop(lines)
        if array.size(labels) > 0
            label.delete(array.get(labels, array.size(labels) - 1))
            array.pop(labels)

var array<line>  posDivLines  = array.new<line>()
var array<line>  negDivLines  = array.new<line>()
var array<label> posDivLabels = array.new<label>()
var array<label> negDivLabels = array.new<label>()
var int  lastPosLines = 0
var int  lastNegLines = 0
var bool removeLastPos = false
var bool removeLastNeg = false
if not na(divPl)
    removeLastPos := false
    lastPosLines := 0
if not na(divPh)
    removeLastNeg := false
    lastNegLines := 0

bool posRegDet = false
bool negRegDet = false
bool posHidDet = false
bool negHidDet = false
int divStart = divNoConfirm ? 0 : 1
int foundType = -1
color topCol = color.white
color botCol = color.white
bool oldPosCanBeRemoved = true
bool oldNegCanBeRemoved = true
array<int>   dList = array.from(dPosReg, dNegReg, dPosHid, dNegHid)
array<color> dCols = array.from(colPosReg, colNegReg, colPosHid, colNegHid)
array<int>   distances = array.new<int>()

if divOn
    for y = 0 to 3
        int dist = array.get(dList, y)
        if dist > 0
            foundType := y
            if y % 2 == 1
                topCol := array.get(dCols, y)
            else
                botCol := array.get(dCols, y)
            if not array.includes(distances, dist)
                array.push(distances, dist)
                line newLine = na
                if divLines
                    float py1 = divSource == "Close" ? close[dist] : (y % 2 == 0 ? low[dist] : high[dist])
                    float py2 = divSource == "Close" ? close[divStart] : (y % 2 == 0 ? low[divStart] : high[divStart])
                    newLine := line.new(bar_index - dist, py1, bar_index - divStart, py2, color = array.get(dCols, y), style = y < 2 ? regLineStyle : hidLineStyle, width = y < 2 ? regWidth : hidWidth)
                if y % 2 == 0
                    if oldPosCanBeRemoved
                        oldPosCanBeRemoved := false
                        if not divShowLast and removeLastPos
                            deleteLastLines(posDivLines, posDivLabels, lastPosLines)
                            lastPosLines := 0
                        if divShowLast
                            deleteAllLines(posDivLines)
                    array.push(posDivLines, newLine)
                    lastPosLines += 1
                    removeLastPos := true
                else
                    if oldNegCanBeRemoved
                        oldNegCanBeRemoved := false
                        if not divShowLast and removeLastNeg
                            deleteLastLines(negDivLines, negDivLabels, lastNegLines)
                            lastNegLines := 0
                        if divShowLast
                            deleteAllLines(negDivLines)
                    array.push(negDivLines, newLine)
                    lastNegLines += 1
                    removeLastNeg := true
            if y == 0
                posRegDet := true
            if y == 1
                negRegDet := true
            if y == 2
                posHidDet := true
            if y == 3
                negHidDet := true

    // Labels (the bearish label sits above the bar, the bullish one below)
    string divName = divNames == "Full" ? "RSI" : "R"
    if foundType >= 0 and divNames != "Don't Show"
        if foundType % 2 == 1
            if divShowLast
                deleteAllLabels(negDivLabels)
            array.push(negDivLabels, label.new(bar_index, math.max(high, high[1]), divName, color = topCol, textcolor = colTxtNeg, style = label.style_label_down))
        else
            if divShowLast
                deleteAllLabels(posDivLabels)
            array.push(posDivLabels, label.new(bar_index, math.min(low, low[1]), divName, color = botCol, textcolor = colTxtPos, style = label.style_label_up))

alertcondition(bullT, "Bull trend", "FGI Replica V3: bullT")
alertcondition(bearT, "Bear trend", "FGI Replica V3: bearT")
alertcondition(buySig, "BUY", "FGI Replica V3: BUY")
alertcondition(sellSig, "SELL", "FGI Replica V3: SELL")
alertcondition(tdBull, "TD bull", "FGI Replica V3: TD bull")
alertcondition(tdBear, "TD bear", "FGI Replica V3: TD bear")
alertcondition(r1, "r letter", "FGI Replica V3: r")
alertcondition(s1, "s letter", "FGI Replica V3: s")
alertcondition(posRegDet, "Positive Regular RSI Divergence", "FGI Replica V3: Positive Regular RSI Divergence")
alertcondition(negRegDet, "Negative Regular RSI Divergence", "FGI Replica V3: Negative Regular RSI Divergence")
alertcondition(posHidDet, "Positive Hidden RSI Divergence", "FGI Replica V3: Positive Hidden RSI Divergence")
alertcondition(negHidDet, "Negative Hidden RSI Divergence", "FGI Replica V3: Negative Hidden RSI Divergence")
alertcondition(l5Final and not l5Final[1], "Entry BUY 5m", "FGI Replica V3: entry BUY 5m")
alertcondition(s5Final and not s5Final[1], "Entry SELL 5m", "FGI Replica V3: entry SELL 5m")
alertcondition(l15Final and not l15Final[1], "Entry BUY 15m", "FGI Replica V3: entry BUY 15m")
alertcondition(s15Final and not s15Final[1], "Entry SELL 15m", "FGI Replica V3: entry SELL 15m")
